<Window x:Class="GitHubContributionWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GitHubContributionWidget"
        mc:Ignorable="d"
        Title="GitHub Contributions"
        Height="300" Width="900"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        Loaded="Window_Loaded">

  <Window.Resources>
    <!-- Color Picker Popup Style -->
    <Style x:Key="ColorPickerButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderThickness="0"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#40FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Border BorderBrush="#50FFFFFF"
          BorderThickness="1"
          CornerRadius="8">

    <Grid Margin="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="35"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Custom Title Bar -->
      <Grid Grid.Row="0" Background="#20000000" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="GitHub Contributions Widget"
                   Grid.Column="0"
                   Foreground="#FFFFFF"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="15,0,0,0"/>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

          <!-- Theme Customization Button -->


          <!-- Pin Button with SVG Icon -->
          <ToggleButton x:Name="PinButton"
                        Width="35"
                        Height="35"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Pin on top (disables close)"
                        Checked="PinButton_Checked"
                        Unchecked="PinButton_Unchecked">
            <ToggleButton.Style>
              <Style TargetType="ToggleButton">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                      <Border Background="{TemplateBinding Background}"
                              BorderThickness="0"
                              CornerRadius="4">
                        <Viewbox Width="16" Height="16"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                          <Canvas Width="24" Height="24">
                            <Path x:Name="PinIcon"
                                  Data="M9.13203 7.79666L3.01631 9.46458C2.27555 9.66661 2.02939 10.5935 2.57232 11.1364L7.01071 15.5748L2.06096 20.5246C1.67044 20.9151 1.67044 21.5483 2.06096 21.9388C2.45148 22.3293 3.08465 22.3293 3.47517 21.9388L8.42492 16.989L12.8633 21.4274C13.4062 21.9704 14.3331 21.7242 14.5352 20.9834L16.2031 14.8677L21.8599 9.21087L22.2135 9.56442C22.4088 9.75969 22.7253 9.75969 22.9206 9.56442L23.6277 8.85732C23.823 8.66205 23.823 8.34547 23.6277 8.15021L15.8495 0.372033C15.6543 0.17677 15.3377 0.17677 15.1424 0.372032L14.4353 1.07914C14.2401 1.2744 14.2401 1.59098 14.4353 1.78625L14.7889 2.1398L9.13203 7.79666ZM14.2736 14.3415C14.3651 14.0057 14.5428 13.6996 14.7889 13.4535L20.4457 7.79666L16.2031 3.55401L10.5462 9.21087C10.3001 9.45698 9.99405 9.63461 9.65826 9.72618L5.20501 10.9407L13.059 18.7947L14.2736 14.3415Z"
                                  Fill="#FFFFFF"
                                  Opacity="0.7"/>
                          </Canvas>
                        </Viewbox>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Background" Value="#401f6feb"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="PinIcon" Property="Opacity" Value="1"/>
                          <Setter Property="Background" Value="#601f6feb"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ToggleButton.Style>
          </ToggleButton>

          <!-- Close Button -->
          <Button x:Name="CloseButton"
                  Content="✕"
                  Width="35"
                  Height="35"
                  FontSize="16"
                  Background="Transparent"
                  Foreground="#FFFFFF"
                  BorderThickness="0"
                  Cursor="Hand"
                  Click="CloseButton_Click"
                  ToolTip="Close">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border Background="{TemplateBinding Background}"
                              BorderThickness="0"
                              CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#60FFFFFF"/>
                    <Setter Property="Opacity" Value="0.4"/>
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#80da3633"/>
                    <Setter Property="Foreground" Value="White"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
      </Grid>




      <!-- Header -->
      <StackPanel Grid.Row="1" Margin="20,15,20,10">
        <TextBlock x:Name="UsernameText"
                   Text="Loading..."
                   Foreground="#FFFFFF"
                   FontSize="16"
                   FontWeight="Bold"/>
        <TextBlock x:Name="TotalContributionsText"
                   Text="Total contributions: 0"
                   Foreground="#D0FFFFFF"
                   FontSize="12"
                   Margin="0,5,0,0"/>
      </StackPanel>

      <!-- Month Labels -->
      <ItemsControl x:Name="MonthLabels"
                    Grid.Row="2"
                    Margin="20,5,20,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding MonthName}"
                       Foreground="#B0FFFFFF"
                       FontSize="10"
                       Width="{Binding Width}"
                       Margin="2,0,0,0"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Contribution Grid -->
      <ScrollViewer Grid.Row="4"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Disabled"
                    Margin="20,5,20,0">
        <ItemsControl x:Name="ContributionGrid" Width="854">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Vertical"
                         Height="112"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="12"
                      Height="12"
                      Margin="2"
                      Background="{Binding Color}"
                      CornerRadius="2"
                      ToolTip="{Binding Tooltip}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Refresh Button and Legend -->
      <StackPanel Grid.Row="5"
                  Orientation="Horizontal"
                  Margin="20,10,20,15">
        <Button x:Name="RefreshButton"
                Content="Refresh"
                Click="RefreshButton_Click"
                Width="100"
                Height="30"
                Background="#80238636"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand">
          <Button.Style>
            <Style TargetType="Button">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            BorderThickness="0">
                      <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#A02ea043"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>

        <!-- Legend -->
        <StackPanel Orientation="Horizontal"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center">
          <TextBlock Text="Less"
                     Foreground="#B0FFFFFF"
                     FontSize="10"
                     VerticalAlignment="Center"
                     Margin="0,0,5,0"/>
          <Border Width="12" Height="12" Margin="2" Background="#161b22" CornerRadius="2"/>
          <Border Width="12" Height="12" Margin="2" Background="#0e4429" CornerRadius="2"/>
          <Border Width="12" Height="12" Margin="2" Background="#006d32" CornerRadius="2"/>
          <Border Width="12" Height="12" Margin="2" Background="#26a641" CornerRadius="2"/>
          <Border Width="12" Height="12" Margin="2" Background="#39d353" CornerRadius="2"/>
          <TextBlock Text="More"
                     Foreground="#B0FFFFFF"
                     FontSize="10"
                     VerticalAlignment="Center"
                     Margin="5,0,0,0"/>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>