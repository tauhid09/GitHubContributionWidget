<Window x:Class="GitHubContributionWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GitHubContributionWidget"
        mc:Ignorable="d"
        Title="GitHub Contributions"
        Height="290" Width="900"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        LocationChanged="Window_LocationChanged"
        Closing="Window_Closing">

  <Window.Resources>

    <!-- Menu item button style -->
    <Style x:Key="MenuItemStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E0FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderThickness="0">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#25FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Toggle menu item style -->
    <Style x:Key="MenuToggleStyle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#E0FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderThickness="0">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#25FFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#20238636"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Segment button style -->
    <Style x:Key="SegmentBtnStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#C9D1D9"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#30363D"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Border BorderBrush="#50FFFFFF"
          BorderThickness="1"
          CornerRadius="0">

    <Grid Margin="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="35"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Custom Title Bar -->
      <Grid Grid.Row="0" Background="#20000000" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- GitHub Logo -->
        <Path Grid.Column="0" Fill="#FFFFFF" VerticalAlignment="Center" Margin="15,0,8,0"
              Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z">
          <Path.LayoutTransform>
            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
          </Path.LayoutTransform>
        </Path>

        <TextBlock Text="GitHub Contributions"
                   Grid.Column="1"
                   Foreground="#FFFFFF"
                   FontSize="13"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>

        <!-- Widget Badge -->
        <Border Grid.Column="2" Background="#1A238636" BorderBrush="#238636" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
           <TextBlock Text="Widget" Foreground="#39D353" FontSize="10" FontWeight="SemiBold"/>
        </Border>

        <!-- Three-dot menu button -->
        <Grid Grid.Column="4">

          <Button x:Name="MenuButton"
                  Width="35"
                  Height="35"
                  Background="Transparent"
                  BorderThickness="0"
                  Cursor="Hand"
                  ToolTip="Options"
                  Click="MenuButton_Click">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bg"
                              Background="{TemplateBinding Background}"
                              BorderThickness="0"
                              CornerRadius="4">
                        <TextBlock Text="&#x22EF;"
                                   Foreground="#FFFFFF"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,4"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bg" Property="Background" Value="#30FFFFFF"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
          </Button>

          <!-- Dropdown Popup Menu -->
          <Popup x:Name="OptionsPopup"
                 PlacementTarget="{Binding ElementName=MenuButton}"
                 Placement="Bottom"
                 StaysOpen="False"
                 AllowsTransparency="True">
            <Border Background="#1C2128"
                    BorderBrush="#50FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0,6"
                    MinWidth="210">
              <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="18"
                                  ShadowDepth="4"
                                  Opacity="0.5"/>
              </Border.Effect>

              <StackPanel>

                <!-- Lock Position -->
                <ToggleButton x:Name="MenuPinToggle"
                              Style="{StaticResource MenuToggleStyle}"
                              Checked="MenuPin_Checked"
                              Unchecked="MenuPin_Unchecked">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F4CC;" FontSize="13" Margin="0,0,10,0"/>
                    <StackPanel>
                      <TextBlock x:Name="PinLabel" Text="Locked (drag disabled)" FontWeight="SemiBold"/>
                      <TextBlock Text="Uncheck to allow dragging the widget"
                                 FontSize="10"
                                 Foreground="#80FFFFFF"
                                 Margin="0,1,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </ToggleButton>

                <!-- Divider -->
                <Border Height="1" Background="#30FFFFFF" Margin="14,4"/>

                <!-- Launch at Startup -->
                <ToggleButton x:Name="MenuStartupToggle"
                              Style="{StaticResource MenuToggleStyle}"
                              Checked="MenuStartup_Checked"
                              Unchecked="MenuStartup_Unchecked">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x26A1;" FontSize="13" Margin="0,0,10,0"/>
                    <StackPanel>
                      <TextBlock x:Name="StartupLabel" Text="Launch at startup" FontWeight="SemiBold"/>
                      <TextBlock x:Name="StartupSubtext"
                                 Text="Opens automatically after login"
                                 FontSize="10"
                                 Foreground="#80FFFFFF"
                                 Margin="0,1,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </ToggleButton>

                <!-- Divider -->
                <Border Height="1" Background="#30FFFFFF" Margin="14,4"/>

                <!-- Refresh -->
                <Button Style="{StaticResource MenuItemStyle}"
                        Click="MenuRefresh_Click">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F504;" FontSize="13" Margin="0,0,10,0"/>
                    <TextBlock Text="Refresh contributions" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>

                <!-- Divider -->
                <Border Height="1" Background="#30FFFFFF" Margin="14,4"/>

                <!-- Logout -->
                <Button Style="{StaticResource MenuItemStyle}"
                        Click="MenuLogout_Click">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F512;" FontSize="13" Margin="0,0,10,0"/>
                    <TextBlock Text="Log out" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>

                <!-- Divider -->
                <Border Height="1" Background="#30FFFFFF" Margin="14,4"/>

                <!-- Close -->
                <Button Style="{StaticResource MenuItemStyle}"
                        Click="MenuClose_Click">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x2715;" FontSize="13" Foreground="#FF6B6B" Margin="0,0,10,0"/>
                    <StackPanel>
                      <TextBlock Text="Close widget" FontWeight="SemiBold" Foreground="#FF6B6B"/>
                      <TextBlock Text="The only way to close"
                                 FontSize="10"
                                 Foreground="#80FFFFFF"
                                 Margin="0,1,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </Button>

              </StackPanel>
            </Border>
          </Popup>
        </Grid>
      </Grid>

      <!-- Header -->
      <!-- Header -->
      <Grid Grid.Row="1" Margin="20,15,20,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/> <!-- Avatar -->
          <ColumnDefinition Width="*"/>    <!-- Text -->
          <ColumnDefinition Width="Auto"/> <!-- Right Controls -->
        </Grid.ColumnDefinitions>

        <!-- Avatar -->
        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#21262D" Margin="0,0,15,0" VerticalAlignment="Center">
          <Border.Effect>
            <DropShadowEffect ShadowDepth="2" BlurRadius="6" Opacity="0.3"/>
          </Border.Effect>
          <Ellipse Width="44" Height="44">
            <Ellipse.Fill>
              <ImageBrush x:Name="UserAvatarImage" Stretch="UniformToFill"/>
            </Ellipse.Fill>
          </Ellipse>
        </Border>

        <!-- Text Stack -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="UsernameText"
                     Text="Loading..."
                     Foreground="#FFFFFF"
                     FontSize="18"
                     FontWeight="Bold"/>
          <TextBlock x:Name="TotalContributionsText"
                     Text="Total contributions: 0"
                     Foreground="#8B949E"
                     FontSize="13"
                     Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Right side controls -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          
          <!-- View Dropdown -->
          <Grid>
             <Button x:Name="ViewSelectorBtn" Padding="12,6" Background="#21262D" Foreground="#C9D1D9" BorderBrush="#30363D" BorderThickness="1" Cursor="Hand" Click="ViewSelectorBtn_Click">
               <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
               <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                 <!-- Simple graph icon path -->
                 <Path Data="M1 11 L5 7 L8 10 L14 4 M14 4 L14 8 M14 4 L10 4" Stroke="#58A6FF" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,8,0" Width="15" Height="15"/>
                 <TextBlock x:Name="CurrentViewText" Text="Heatmap" FontWeight="SemiBold" FontSize="12"/>
                 <TextBlock Text="▼" FontSize="8" Margin="8,2,0,0" Foreground="#80FFFFFF"/>
               </StackPanel>
             </Button>

             <Popup x:Name="ViewPopup" PlacementTarget="{Binding ElementName=ViewSelectorBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
               <Border Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="0,4" Margin="0,4,0,0" MinWidth="120">
                 <StackPanel>
                   <Button Style="{StaticResource MenuItemStyle}" Tag="Heatmap" Click="ViewOption_Click">
                     <TextBlock Text="Heatmap" FontWeight="SemiBold"/>
                   </Button>
                   <Button Style="{StaticResource MenuItemStyle}" Tag="Line Chart" Click="ViewOption_Click">
                     <TextBlock Text="Line Chart" FontWeight="SemiBold"/>
                   </Button>
                   <Button Style="{StaticResource MenuItemStyle}" Tag="Bar Chart" Click="ViewOption_Click">
                     <TextBlock Text="Bar Chart" FontWeight="SemiBold"/>
                   </Button>
                   <Button Style="{StaticResource MenuItemStyle}" Tag="Pie Chart" Click="ViewOption_Click">
                     <TextBlock Text="Pie Chart" FontWeight="SemiBold"/>
                   </Button>
                 </StackPanel>
               </Border>
             </Popup>
          </Grid>

          <!-- Timeframe Segment -->
          <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Margin="10,0,0,0" Padding="2">
             <StackPanel Orientation="Horizontal" x:Name="TimeframePanel">
                <Button Content="1Y" Style="{StaticResource SegmentBtnStyle}" Foreground="#39D353" Background="#1A238636" FontWeight="SemiBold" Click="TimeframeBtn_Click" Tag="1Y"/>
                <Button Content="6M" Style="{StaticResource SegmentBtnStyle}" Click="TimeframeBtn_Click" Tag="6M"/>
                <Button Content="3M" Style="{StaticResource SegmentBtnStyle}" Click="TimeframeBtn_Click" Tag="3M"/>
                <Button Content="1M" Style="{StaticResource SegmentBtnStyle}" Click="TimeframeBtn_Click" Tag="1M"/>
             </StackPanel>
          </Border>

          <!-- Year Selector -->
          <Grid Margin="10,0,0,0">
             <Button x:Name="YearSelectorBtn" Padding="12,6" Background="#21262D" Foreground="#C9D1D9" BorderBrush="#30363D" BorderThickness="1" Cursor="Hand" Click="YearSelectorBtn_Click">
               <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
               <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                 <TextBlock Text="📅" FontSize="12" Margin="0,0,8,0" Foreground="#8B949E"/>
                 <TextBlock x:Name="CurrentYearText" Text="2025" FontWeight="SemiBold" FontSize="12"/>
                 <TextBlock Text="▼" FontSize="8" Margin="8,2,0,0" Foreground="#80FFFFFF"/>
               </StackPanel>
             </Button>

             <Popup x:Name="YearPopup" PlacementTarget="{Binding ElementName=YearSelectorBtn}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
               <Border Background="#1C2128" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="0,4" Margin="0,4,0,0" MinWidth="100">
                 <StackPanel x:Name="YearPopupList">
                   <!-- Filled dynamically or manually -->
                 </StackPanel>
               </Border>
             </Popup>
          </Grid>

        </StackPanel>
      </Grid>

      <!-- Chart Canvas -->
      <Canvas x:Name="ChartCanvas"
              Grid.Row="2"
              Margin="10,0,10,10"
              SizeChanged="ChartCanvas_SizeChanged"
              ClipToBounds="True"/>

    </Grid>
  </Border>
</Window>
